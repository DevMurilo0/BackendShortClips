# Variáveis PRIVADAS da Vercel, nunca comitar valores reais.
SHORTFORGE_FRONTEND_ORIGIN=https://short-clips-tan.vercel.app
SHORTFORGE_PUBLIC_API_URL=https://backend-short-clips.vercel.app

# Único usuário: segredo longo de 32+ bytes; informado no painel do ShortForge
SHORTFORGE_PUBLIC_ACCESS_KEY=GERAR_CHAVE_ALEATORIA_SEGURA

# Callback interno do worker (precisa ser DIFERENTE da chave acima)
SHORTFORGE_WORKER_SECRET=GERAR_OUTRA_CHAVE_ALEATORIA_SEGURA

# Consome franquia/recursos: ative apenas DEPOIS de criar o Blob PRIVADO e testar permissões
# SEM esta variável o backend permanece em modo gateway, sem custo de Sandbox.
# SHORTFORGE_ENGINE=sandbox

# Token conectado automaticamente ao projeto pela Vercel Blob (não compartilhar)
BLOB_READ_WRITE_TOKEN=TOKEN_DO_BLOB_PRIVADO

# Limite padrão 3 jobs/mês; valores maiores são ignorados por segurança.
SHORTFORGE_MAX_JOBS_MONTH=3

# Cron da Vercel; deve ser segredo gerado pela própria Vercel, não GitHub
CRON_SECRET=GERAR_SEGREDO_DO_CRON

# Gateway alternativo anterior (não é necessário em modo Sandbox):
# SHORTFORGE_WORKER_URL=https://seu-worker-externo.example

# Imagem VCR opcional com dependências prontas, usar digest após homologar
# SHORTFORGE_SANDBOX_IMAGE=shortforge-worker@sha256:...
